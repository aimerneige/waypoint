# 开发配置；上线前替换密码、签名密钥及 SMTP 参数
POSTGRES_DB=waypoint
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint_dev_only
# Compose 内部地址；本地开发请改用 README 中的端口转发地址
DATABASE_URL=postgres://waypoint:waypoint_dev_only@postgres:5432/waypoint?sslmode=disable
PORT=8080
PUBLIC_BASE_URL=http://localhost:8088
SIGNING_KEY=development-only-replace-before-deployment
UPLOAD_DIR=/uploads
MAX_UPLOAD_MB=32
# 比应用上传限制多 1MB；修改 MAX_UPLOAD_MB 时同步调整
CADDY_MAX_BODY_SIZE=33MB
# 骨架阶段不发送邮件，以下为占位；生产环境必须替换
SMTP_HOST=mail
SMTP_PORT=587
SMTP_USER=waypoint
SMTP_PASSWORD=development-only
SMTP_FROM=waypoint@localhost
# M6 跨域来源预留，逗号分隔，默认空
CORS_ALLOWED_ORIGINS=
# 默认相对 API 路径；本地 Vite 构建时读取，原生客户端阶段使用
VITE_API_BASE_URL=
# 开发默认纯 HTTP；正式部署替换站点地址
WAYPOINT_DOMAIN=http://localhost
WEB_HTTP_PORT=8088
WEB_HTTPS_PORT=8443
# 每日备份保留天数；设为 1 可在备份容器启动时立即备份
BACKUP_KEEP_DAYS=14
BACKUP_ON_START=0
# 真实 PostgreSQL 集成测试连接，未设置则跳过
TEST_DATABASE_URL=
